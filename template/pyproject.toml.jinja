[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = {{ tool_name | tojson }}
dynamic = ["version"]
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">=3.10"
license = "GPL-3.0-or-later"
license-files = ["LICENSE"]
authors = [{ name = {{ author | tojson }} }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Web Environment",
    "Programming Language :: Python :: 3",
]

# {{ cli_module }}.py is standard library only. Flask is the web page's{% if with_mcp %}, and mcp
# is the agent server's{% endif %}; every console script below is installed, so
# these are dependencies rather than optional extras.
dependencies = ["flask>=3.0"{% if with_mcp %}, "mcp>=2,<3"{% endif %}]

[project.urls]
Homepage = "https://github.com/{{ github_org }}/{{ repo_name }}"
Source = "https://github.com/{{ github_org }}/{{ repo_name }}"
Issues = "https://github.com/{{ github_org }}/{{ repo_name }}/issues"

[project.scripts]
{{ cli_command }} = "{{ package_name }}.{{ cli_module }}:main"
{{ cli_command }}-web = "{{ package_name }}.app:main"
{%- if with_mcp %}
{{ cli_command }}-mcp = "{{ package_name }}.mcp_server:main"
{%- endif %}
{{ cli_command }}-skill = "{{ package_name }}.core.skill_install:main"

[tool.setuptools]
packages = ["{{ package_name }}", "{{ package_name }}.core"]

# Flask resolves templates/ and static/ relative to the module that owns them,
# and core/version.py reads VERSION beside the package, so all of it has to be
# installed alongside the code. skill/ ships so an install can hand the agent
# skill over without the repository. tests/test_core.py checks this list.
[tool.setuptools.package-data]
{{ package_name }} = ["VERSION", "templates/*.html", "static/*", "skill/*.md"{% if with_workspace %}, "{{ shared_dir }}/*.json"{% endif %}]
"{{ package_name }}.core" = ["static/*", "templates/core/*.html"]

[tool.setuptools.dynamic]
version = { file = "{{ package_name }}/VERSION" }

[tool.pytest.ini_options]
testpaths = ["tests"]
# Use ./test.sh rather than calling pytest directly: a ROS 2 workstation leaks
# pytest plugins in through PYTHONPATH that cannot import here.
